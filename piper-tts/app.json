{
  "name": "piper-tts",
  "version": "0.1.7",
  "displayName": "Piper TTS",
  "description": "Text-to-speech using Piper neural voice models. Download and manage TTS voices for audio output.",
  "icon": "Volume2",
  "author": "PersonalClaw",
  "license": "MIT",
  "tags": [
    "model",
    "tts"
  ],
  "dependencies": {
    "pythonDependencies": [
      "piper-tts>=1.2",
      "huggingface-hub>=0.23"
    ]
  },
  "permissions": {
    "network": true
  },
  "launches": [
    {
      "program": "piper",
      "why": "Piper turns each spoken reply into audio, with the voice you chose."
    }
  ],
  "provider": {
    "id": "text-to-speech",
    "label": "Speak text with Piper voices",
    "renamedFrom": [
      "model"
    ],
    "type": "model",
    "implementation": "provider:create_provider",
    "capabilities": [
      "tts"
    ],
    "settingsSchema": {
      "type": "object",
      "properties": {}
    }
  }
}
