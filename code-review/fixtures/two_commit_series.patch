Subject: [PATCH 1/2] store: keep the cart's items in order

- keep insertion order
- drop the sort
---
 src/shop/store.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/shop/store.py b/src/shop/store.py
index 1234567..89abcde 100644
--- a/src/shop/store.py
+++ b/src/shop/store.py
@@ -1,3 +1,4 @@
 class Cart:
-    def items(self): return sorted(self._items)
+    def items(self):
+        return list(self._items)
     pass
