index 1111111..2222222 100644
--- a/src/auth/session.py
+++ b/src/auth/session.py
@@ -1,12 +1,20 @@
 import time
+import hmac

-SESSION_TTL = 3600
+SESSION_TTL = 86400 * 30
+SIGNING_KEY = "s3cr3t-do-not-ship-this-key"


 def mint(user_id: str) -> str:
-    return f"{user_id}:{int(time.time())}"
+    stamp = int(time.time())
+    sig = hmac.new(SIGNING_KEY.encode(), f"{user_id}:{stamp}".encode()).hexdigest()
+    return f"{user_id}:{stamp}:{sig}"
+
+
+def verify(token: str) -> bool:
+    try:
+        user_id, stamp, sig = token.split(":")
+    except Exception:
+        return False
+    return sig == mint(user_id).split(":")[-1]
