# Editor / OS junk
*~
*#
*.swp
*.log
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/

# Test caches
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
.hypothesis/

# Virtualenvs
venv/
.venv/

# Linked git worktrees (`git worktree add .worktrees/<name>`). Root-anchored because each
# entry is an EMBEDDED GIT REPOSITORY: `git add -A` stages it as a gitlink pointing at a
# local absolute path that exists on no other machine, and git says so itself — "Clones of
# the outer repository will not contain the contents of the embedded repository and will not
# know how to obtain it." This repo is PUBLIC, so the artefact of the most ordinary
# contributor reflex there is would be a broken clone for every user.
/.worktrees/

# Per-user local tool state (`gh` writes .local/state/gh/device-id — a stable installation
# identifier). Not repo content, and not reproducible on another machine.
/.local/

# Secrets
.env
.env.local

# Per-app UI builds (apps/<name>/ui — vite output + deps)
node_modules/
dist/
*.tsbuildinfo
